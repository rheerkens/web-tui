{
  "name": "waypoint-terminal",
  "version": "1.0.0",
  "description": "A browser terminal for persistent AI coding-agent sessions backed by tmux.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/rheerkens/web-tui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rheerkens/web-tui.git"
  },
  "bugs": "https://github.com/rheerkens/web-tui/issues",
  "bin": {
    "waypoint": "bin/waypoint.js",
    "waypoint-auth": "bin/waypoint-auth.js"
  },
  "files": [
    "bin/",
    "public/",
    "src/",
    "scripts/",
    "server.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "auth:link": "node bin/waypoint-auth.js",
    "build": "esbuild src/app.js --bundle --minify --sourcemap --outfile=public/app.js",
    "dev": "npm run build && node --watch server.js",
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "express": "^5.1.0",
    "node-pty": "^1.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.6",
    "playwright": "^1.61.1"
  }
}
